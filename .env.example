# =====================================================================
# Environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — only put
# public, non-secret values in them.
# =====================================================================

# --- Site ------------------------------------------------------------
# Canonical public URL of the site (no trailing slash). Used for canonical
# tags, sitemap, Open Graph and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) ---------------------------------------------
# Project Settings > API in the Supabase dashboard, or `npx supabase status`
# for the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (or legacy "anon") key — safe for the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (or legacy "service_role") key — SERVER ONLY. Used for click
# tracking, rate limiting, newsletter/contact storage and admin user
# management. Never expose it to the client.
SUPABASE_SECRET_KEY=

# --- Security --------------------------------------------------------
# Random string (32+ chars) used to salt IP hashes for analytics/rate limiting.
# Generate with: openssl rand -hex 32
IP_HASH_SALT=
# Shared secret for the scheduled listing refresh endpoint (/api/cron/refresh-listings).
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Analytics & search console (optional) ----------------------------
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX (public by design).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (content value only).
GOOGLE_SITE_VERIFICATION=

# --- Amazon Creators API (optional; replaces the retired PA-API 5.0) ---
# Credentials from Associates Central > Tools > Creators API. Server only.
# India (amazon.in) belongs to the EU region group. Verify every value
# against the current Creators API documentation for your credential version.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
# Credential version shown in Associates Central (e.g. 3.2 for EU/IN group).
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_CREATORS_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token
AMAZON_CREATORS_API_BASE_URL=https://creatorsapi.amazon
AMAZON_CREATORS_MARKETPLACE=www.amazon.in
# Your Associates tracking id (partner tag), e.g. yourtag-21
AMAZON_PARTNER_TAG=

# --- Flipkart Affiliate API (optional) --------------------------------
# From the Flipkart Affiliate dashboard (API token section). Server only.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
FLIPKART_API_BASE_URL=https://affiliate-api.flipkart.net

# --- Newsletter provider (optional) -----------------------------------
# none (default: store consented subscribers in the database only),
# brevo or mailchimp.
NEWSLETTER_PROVIDER=none
BREVO_API_KEY=
BREVO_LIST_ID=
MAILCHIMP_API_KEY=
# e.g. us21 — the suffix of your Mailchimp API key
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# --- Google sign-in (optional) -----------------------------------------
# Set to "true" after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
